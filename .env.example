# Параметры локального запуска. Реальные значения хранятся только в .env на сервере.
POSTGRES_DB=homtech_seller
POSTGRES_USER=homtech_seller_app
POSTGRES_PASSWORD=change-me-before-any-launch
DATABASE_URL=postgresql://homtech_seller_app:change-me-before-any-launch@postgres:5432/homtech_seller

# Независимый от CRM ключ шифрования токенов маркетплейсов.
MARKETPLACE_CREDENTIALS_SECRET=replace-with-a-new-long-random-secret
SELLER_AUTH_JWT_SECRET=replace-with-another-long-random-secret
SELLER_AUTH_JWT_TTL_MIN=720
SELLER_COOKIE_SECURE=false
UVICORN_WORKERS=1
