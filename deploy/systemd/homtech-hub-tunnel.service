[Unit]
Description=HomTech Seller private tunnel to Supplier Hub
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=adminops
Group=adminops
ExecStart=/usr/bin/ssh -NT -i /home/adminops/.ssh/homtech_hub_tunnel_ed25519 -o BatchMode=yes -o PasswordAuthentication=no -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/adminops/.ssh/homtech_hub_known_hosts -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o LogLevel=ERROR -L 127.0.0.1:18010:127.0.0.1:8010 -L 172.18.0.1:18010:127.0.0.1:8010 adminops@138.16.162.73
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
